<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>cz.xprees.secrets</id>
    <name>EnvBridge</name>
    <vendor url="https://github.com/xprees">xprees</vendor>
    <!-- <description> and <change-notes> are filled in from README.md / CHANGELOG.md by the Gradle build -->

    <depends>com.intellij.modules.platform</depends>
    <!-- Each integration is optional, so the plugin loads in every IDE -->
    <depends optional="true" config-file="secrets-maven.xml">org.jetbrains.idea.maven</depends>
    <depends optional="true" config-file="secrets-nodejs.xml">NodeJS</depends>
    <depends optional="true" config-file="secrets-javascript.xml">JavaScript</depends>
    <depends optional="true" config-file="secrets-python.xml">PythonCore</depends>
    <depends optional="true" config-file="secrets-go.xml">org.jetbrains.plugins.go</depends>
    <depends optional="true" config-file="secrets-docker.xml">Docker</depends>
    <depends optional="true" config-file="secrets-terminal.xml">org.jetbrains.plugins.terminal</depends>
    <depends optional="true" config-file="secrets-rider.xml">com.intellij.modules.rider</depends>
    <depends optional="true" config-file="secrets-json.xml">com.intellij.modules.json</depends>
    <depends optional="true" config-file="secrets-database.xml">com.intellij.database</depends>
    <!-- Inlay hints are registered per language, in the plugin that defines it -->
    <depends optional="true" config-file="secrets-lang-java.xml">com.intellij.java</depends>
    <depends optional="true" config-file="secrets-lang-kotlin.xml">org.jetbrains.kotlin</depends>
    <depends optional="true" config-file="secrets-lang-yaml.xml">org.jetbrains.plugins.yaml</depends>
    <depends optional="true" config-file="secrets-lang-properties.xml">com.intellij.properties</depends>
    <depends optional="true" config-file="secrets-lang-xml.xml">com.intellij.modules.xml</depends>
    <depends optional="true" config-file="secrets-lang-shell.xml">com.jetbrains.sh</depends>
    <depends optional="true" config-file="secrets-lang-dotenv.xml">ru.adelf.idea.dotenv</depends>
    <depends optional="true" config-file="secrets-lang-php.xml">com.jetbrains.php</depends>
    <depends optional="true" config-file="secrets-lang-ruby.xml">org.jetbrains.plugins.ruby</depends>
    <depends optional="true" config-file="secrets-lang-rust.xml">com.jetbrains.rust</depends>

    <resource-bundle>messages.SecretsBundle</resource-bundle>

    <extensionPoints>
        <!-- Secret managers: Infisical, HashiCorp Vault / OpenBao, 1Password, Doppler, AWS Secrets Manager -->
        <extensionPoint qualifiedName="cz.xprees.secrets.provider" interface="cz.xprees.secrets.core.provider.SecretProvider"
                        dynamic="true"/>
        <!-- Reading and replacing the environment variables of one kind of run configuration -->
        <extensionPoint qualifiedName="cz.xprees.secrets.envPatcher" interface="cz.xprees.secrets.run.EnvPatcher" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="cz.xprees.secrets">
        <provider implementation="cz.xprees.secrets.infisical.InfisicalProvider"/>
        <provider implementation="cz.xprees.secrets.vault.VaultProvider"/>
        <provider implementation="cz.xprees.secrets.onepassword.OnePasswordProvider"/>
        <provider implementation="cz.xprees.secrets.doppler.DopplerProvider"/>
        <provider implementation="cz.xprees.secrets.aws.AwsSecretsManagerProvider"/>
        <envPatcher implementation="cz.xprees.secrets.run.ExternalSystemEnvPatcher"/>
        <envPatcher implementation="cz.xprees.secrets.run.CommonParametersEnvPatcher"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- First, so it sees configurations with secret references before the runner that launches them -->
        <programRunner implementation="cz.xprees.secrets.run.SecretsProgramRunner" order="first"/>

        <toolWindow id="Secrets" anchor="right" secondary="false" icon="cz.xprees.secrets.SecretsIcons.TOOL_WINDOW"
                    factoryClass="cz.xprees.secrets.ui.toolwindow.SecretsToolWindowFactory"/>
        <projectConfigurable parentId="tools" id="cz.xprees.secrets.settings"
                             instance="cz.xprees.secrets.ui.settings.SecretsConfigurable"
                             key="settings.display.name" bundle="messages.SecretsBundle"/>
        <notificationGroup id="EnvBridge" displayType="BALLOON" key="notification.group.name"/>

        <!-- Editor: completion, hover and gutter, masked inlays, missing-secret inspection; language-agnostic -->
        <completion.contributor language="any" implementationClass="cz.xprees.secrets.editor.SecretKeyCompletionContributor"/>
        <typedHandler implementation="cz.xprees.secrets.editor.SecretKeyAutoPopup"/>
        <!-- language="" applies an external annotator to every language -->
        <externalAnnotator language="" implementationClass="cz.xprees.secrets.editor.SecretReferenceAnnotator"/>
        <!-- Plain text here; other languages in the secrets-lang-*.xml / integration configs -->
        <codeInsight.declarativeInlayProvider language="TEXT" implementationClass="cz.xprees.secrets.editor.SecretInlayHintsProvider"
                                              isEnabledByDefault="true" group="VALUES_GROUP" providerId="cz.xprees.secrets.hints"
                                              bundle="messages.SecretsBundle" nameKey="inlay.provider.name"
                                              descriptionKey="inlay.provider.description"/>
        <localInspection shortName="InfisicalMissingSecret" bundle="messages.SecretsBundle" key="inspection.missing.display.name"
                         groupKey="inspection.group.name" enabledByDefault="true" level="WARNING"
                         implementationClass="cz.xprees.secrets.editor.MissingSecretInspection"/>
        <localInspection shortName="InfisicalDotEnvPlaintextSecret" bundle="messages.SecretsBundle" key="inspection.dotenv.display.name"
                         groupKey="inspection.group.name" enabledByDefault="true" level="WEAK WARNING"
                         implementationClass="cz.xprees.secrets.editor.DotEnvPlaintextSecretInspection"/>
        <codeInsight.inlayActionHandler handlerId="cz.xprees.secrets.showSecret"
                                        implementationClass="cz.xprees.secrets.editor.ShowSecretInlayActionHandler"/>
        <intentionAction>
            <className>cz.xprees.secrets.editor.DotEnvBindIntention</className>
            <bundleName>messages.SecretsBundle</bundleName>
            <categoryKey>inspection.group.name</categoryKey>
        </intentionAction>
        <intentionAction>
            <className>cz.xprees.secrets.editor.DotEnvBindToSecretIntention</className>
            <bundleName>messages.SecretsBundle</bundleName>
            <categoryKey>inspection.group.name</categoryKey>
        </intentionAction>
        <intentionAction>
            <className>cz.xprees.secrets.editor.DotEnvExtractToSecretIntention</className>
            <bundleName>messages.SecretsBundle</bundleName>
            <categoryKey>inspection.group.name</categoryKey>
        </intentionAction>

        <!-- Console masking of injected values -->
        <consoleInputFilterProvider implementation="cz.xprees.secrets.run.masking.SecretMaskingFilterProvider"/>

        <statusBarWidgetFactory id="SecretsForInfisical" implementation="cz.xprees.secrets.ui.status.SecretsStatusBarWidgetFactory"
                                order="after positionWidget"/>
    </extensions>

    <!-- Kotlin is only an optional dependency for inlay hints; no Kotlin analysis API is used, so K2 mode is supported -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <projectListeners>
        <listener class="cz.xprees.secrets.run.masking.SecretMaskingExecutionListener" topic="com.intellij.execution.ExecutionListener"/>
    </projectListeners>

    <actions>
        <action id="cz.xprees.secrets.RunWithEnvironment" class="cz.xprees.secrets.ui.actions.RunWithEnvironmentAction"
                text="Run with Secrets Environment…"
                description="Run the selected configuration once with secrets from another environment">
            <add-to-group group-id="RunMenu" anchor="after" relative-to-action="ChooseRunConfiguration"/>
        </action>
        <action id="cz.xprees.secrets.AddSecretsToRunConfiguration" class="cz.xprees.secrets.ui.actions.AddSecretsToRunConfigurationAction"
                text="Add Secrets to Run Configuration…"
                description="Pick secrets of the bound folder and add references to them to a run configuration's environment variables">
            <add-to-group group-id="RunMenu" anchor="after" relative-to-action="cz.xprees.secrets.RunWithEnvironment"/>
        </action>
        <!-- Right-click menu of a masked secret hint -->
        <group id="cz.xprees.secrets.InlayMenu">
            <separator/>
            <action id="cz.xprees.secrets.inlay.PreviewValue" class="cz.xprees.secrets.editor.PreviewSecretValueInlayAction"
                    text="Preview Secret Value" description="Show the secret's value next to the caret until the next keystroke"/>
            <action id="cz.xprees.secrets.inlay.CopyValue" class="cz.xprees.secrets.editor.CopySecretValueInlayAction"
                    text="Copy Secret Value" description="Copy the secret's value to the clipboard"/>
            <add-to-group group-id="InlayMenu" anchor="first"/>
        </group>
    </actions>
</idea-plugin>
