<idea-plugin>
    <extensions defaultExtensionNs="org.jetbrains.plugins.terminal">
        <shellExecOptionsCustomizer implementation="cz.xprees.secrets.terminal.SecretsTerminalCustomizer"/>
    </extensions>

    <actions>
        <!-- Next to the terminal's own New Tab button; also in Find Action -->
        <action id="cz.xprees.secrets.NewTerminalWithSecrets" class="cz.xprees.secrets.terminal.NewTerminalWithSecretsAction"
                text="New Terminal Tab with Secrets"
                description="Open a terminal tab whose shell starts with the secrets of the bound folder (or the project's terminal references) in its environment">
            <add-to-group group-id="TerminalToolwindowActionGroup" anchor="after" relative-to-action="Terminal.NewTab"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="cz.xprees.secrets.LoadSecretsIntoTerminal" class="cz.xprees.secrets.terminal.LoadSecretsIntoTerminalAction"
                text="Load Secrets into This Terminal"
                description="Set the secrets of the bound folder (or the project's terminal references) in the shell of the current terminal tab, in its own syntax (PowerShell, cmd, bash, zsh, fish)">
            <add-to-group group-id="TerminalToolwindowActionGroup" anchor="after" relative-to-action="cz.xprees.secrets.NewTerminalWithSecrets"/>
            <add-to-group group-id="Terminal.ReworkedTerminalContextMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
