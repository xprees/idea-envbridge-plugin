<!-- Masked secret hints in yaml files (the provider is language-bound; the detection is not) -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.declarativeInlayProvider language="yaml" implementationClass="cz.xprees.secrets.editor.SecretInlayHintsProvider"
                                              isEnabledByDefault="true" group="VALUES_GROUP" providerId="cz.xprees.secrets.hints"
                                              bundle="messages.SecretsBundle" nameKey="inlay.provider.name"
                                              descriptionKey="inlay.provider.description"/>
    </extensions>
</idea-plugin>
