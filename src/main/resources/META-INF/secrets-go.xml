<idea-plugin>
    <extensions defaultExtensionNs="cz.xprees.secrets">
        <envPatcher implementation="cz.xprees.secrets.run.go.GoEnvPatcher"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.declarativeInlayProvider language="go" implementationClass="cz.xprees.secrets.editor.SecretInlayHintsProvider"
                                              isEnabledByDefault="true" group="VALUES_GROUP" providerId="cz.xprees.secrets.hints"
                                              bundle="messages.SecretsBundle" nameKey="inlay.provider.name"
                                              descriptionKey="inlay.provider.description"/>
    </extensions>
</idea-plugin>
