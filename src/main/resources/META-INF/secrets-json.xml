<!-- appsettings*.json: settings overridden by secrets, plaintext secrets -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <annotator language="JSON" implementationClass="cz.xprees.secrets.dotnet.AppSettingsSecretAnnotator"/>
        <localInspection language="JSON" shortName="InfisicalAppSettingsPlaintextSecret" bundle="messages.SecretsBundle"
                         key="appsettings.inspection.name" groupKey="inspection.group.name" enabledByDefault="true"
                         level="WEAK WARNING" implementationClass="cz.xprees.secrets.dotnet.AppSettingsPlaintextSecretInspection"/>
    </extensions>
</idea-plugin>
