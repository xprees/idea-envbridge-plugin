<!-- The JavaScript plugin: npm / pnpm / Yarn / Bun script run configurations, and masked secret hints in JavaScript and its dialects (TypeScript, …) -->
<idea-plugin>
    <extensions defaultExtensionNs="cz.xprees.secrets">
        <envPatcher implementation="cz.xprees.secrets.run.node.NpmEnvPatcher"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.declarativeInlayProvider language="JavaScript" implementationClass="cz.xprees.secrets.editor.SecretInlayHintsProvider"
                                              isEnabledByDefault="true" group="VALUES_GROUP" providerId="cz.xprees.secrets.hints"
                                              bundle="messages.SecretsBundle" nameKey="inlay.provider.name"
                                              descriptionKey="inlay.provider.description"/>
    </extensions>
</idea-plugin>
